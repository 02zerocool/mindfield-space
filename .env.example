# Mindfield-Space — environment configuration

# ── Core ──────────────────────────────────────────────────────────────────────
LANCE_DB_PATH=./lancedb
LEAN_PORT=8018
EMBED_PORT=8082
EMBED_URL=http://127.0.0.1:8082
EMBED_MODEL=nomic-embed-text-v1.5
EMBED_DIM=768

# ── Domain ports (one lean_api per knowledge domain) ─────────────────────────
# These are started by: python mission/domains.py --start-all
DOMAIN_TELEMETRY_PORT=18001
DOMAIN_PROCEDURES_PORT=18002
DOMAIN_FMEA_PORT=18003
DOMAIN_PROPULSION_PORT=18004
DOMAIN_ASTRODYNAMICS_PORT=18005
DOMAIN_LIFE_SUPPORT_PORT=18006
DOMAIN_COMMS_PORT=18007
DOMAIN_SCIENCE_PORT=18008
DOMAIN_REGULATIONS_PORT=18009
DOMAIN_PLANETARY_PORT=18010

# ── NASA ADS (optional — required only for ingest_ads.py) ────────────────────
# Free API key: https://ui.adsabs.harvard.edu/user/settings/token
# ADS_API_KEY=your_key_here

# ── Optional GGUF inference ───────────────────────────────────────────────────
# GGUF_MODEL_PATH=./models/your-model.gguf
# GGUF_PORT=8009
# GGUF_GPU_LAYERS=99
